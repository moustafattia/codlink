+/// Resolve a CLI tool name like `git` to an absolute path on Android.
+///
+/// Android app sandboxes can spawn bundled executables from `nativeLibraryDir`,
+/// but those binaries are packaged as `lib<tool>.so` rather than discovered on
+/// `PATH`. Mobile code registers a resolver during startup so the exec path can
+/// rewrite `argv[0]` before spawning the process.
+#[cfg(target_os = "android")]
+pub(crate) static ANDROID_TOOL_RESOLVER: OnceLock<fn(&str) -> Option<String>> = OnceLock::new();
+
+/// Register the Android tool resolver. The first registration wins.
+#[cfg(target_os = "android")]
+pub fn set_android_tool_resolver(f: fn(&str) -> Option<String>) {
+    let _ = ANDROID_TOOL_RESOLVER.set(f);
+}
